    {"en": "Do you accept cash?", "te": "డూ యూ యాక్సెప్ట్ క్యాష్?", "meaning": "మీరు నగదు తీసుకుంటారా?"},
    {"en": "Where is the counter?", "te": "వేర్ ఈజ్ ది కౌంటర్?", "meaning": "కౌంటర్ ఎక్కడ ఉంది?"},
    {"en": "The item is damaged", "te": "ది ఐటమ్ ఈజ్ డ్యామేజ్డ్", "meaning": "వస్తువు దెబ్బతింది"},
    {"en": "I want a refund", "te": "ఐ వాంట్ ఆ రీఫండ్", "meaning": "నాకు డబ్బులు తిరిగి ఇవ్వండి"},
    {"en": "Do you have a guarantee?", "te": "డూ యూ హావ్ ఆ గ్యారెంటీ?", "meaning": "మీ దగ్గర గ్యారెంటీ ఉందా?"},
    {"en": "This is very beautiful", "te": "దిస్ ఈజ్ వెరీ బ్యూటిఫుల్", "meaning": "ఇది చాలా అందంగా ఉంది"},
    {"en": "I will buy it later", "te": "ఐ విల్ బై ఇట్ లేటర్", "meaning": "నేను దీన్ని తర్వాత కొంటాను"},
    {"en": "It is on sale", "te": "ఇట్ ఈజ్ ఆన్ సేల్", "meaning": "ఇది సేల్‌లో ఉంది"},
    {"en": "Where is the entrance?", "te": "వేర్ ఈజ్ ది ఎంట్రన్స్?", "meaning": "ప్రవేశ ద్వారం ఎక్కడ ఉంది?"},
    {"en": "Where is the exit?", "te": "వేర్ ఈజ్ ది ఎగ్జిట్?", "meaning": "బయటకు వెళ్లే దారి ఎక్కడ ఉంది?"},
    {"en": "Is it open?", "te": "ఈజ్ ఇట్ ఓపెన్?", "meaning": "ఇది తెరిచి ఉందా?"},
    {"en": "When do you close?", "te": "వెన్ డూ యూ క్లోజ్?", "meaning": "మీరు ఎప్పుడు మూసివేస్తారు?"},
    {"en": "I am looking for a shirt", "te": "ఐ యామ్ లుకింగ్ ఫర్ ఆ షర్ట్", "meaning": "నేను చొక్కా కోసం చూస్తున్నాను"},
    {"en": "Do you have pants?", "te": "డూ యూ హావ్ ప్యాంట్స్?", "meaning": "మీ దగ్గర ప్యాంటు ఉందా?"},
    {"en": "I need shoes", "te": "ఐ నీడ్ షూస్", "meaning": "నాకు బూట్లు కావాలి"},
    {"en": "What brand is this?", "te": "వాట్ బ్రాండ్ ఈజ్ దిస్?", "meaning": "ఇది ఏ బ్రాండ్?"},
    {"en": "This fits me well", "te": "దిస్ ఫిట్స్ మీ వెల్", "meaning": "ఇది నాకు బాగా సరిపోయింది"},
    {"en": "This is too big", "te": "దిస్ ఈజ్ టూ బిగ్", "meaning": "ఇది చాలా పెద్దది"},
    {"en": "This is too small", "te": "దిస్ ఈజ్ టూ స్మాల్", "meaning": "ఇది చాలా చిన్నది"},
    {"en": "Do you have a bag?", "te": "డూ యూ హావ్ ఆ బ్యాగ్?", "meaning": "మీ దగ్గర బ్యాగ్ ఉందా?"},
    {"en": "Put it in the bag", "te": "పుట్ ఇట్ ఇన్ ది బ్యాగ్", "meaning": "దాన్ని బ్యాగ్‌లో పెట్టండి"},
    {"en": "I like the color", "te": "ఐ లైక్ ది కలర్", "meaning": "నాకు ఈ రంగు నచ్చింది"},
    {"en": "It is too bright", "te": "ఇట్ ఈజ్ టూ బ్రైట్", "meaning": "ఇది చాలా ప్రకాశవంతంగా ఉంది"},
    {"en": "Do you have something plain?", "te": "డూ యూ హావ్ సంథింగ్ ప్లెయిన్?", "meaning": "మీ దగ్గర సాధారణమైనది ఉందా?"},
    {"en": "I will think about it", "te": "ఐ విల్ థింక్ అబౌట్ ఇట్", "meaning": "నేను ఆలోచిస్తాను"},
    {"en": "Thanks for showing", "te": "థాంక్స్ ఫర్ షోయింగ్", "meaning": "చూపించినందుకు ధన్యవాదాలు"}
