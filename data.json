  "Level 7: Feelings": [
    {"en": "I am happy", "te": "నేను సంతోషంగా ఉన్నాను", "meaning": "ఐ యామ్ హ్యాపీ"},
    {"en": "I am sad", "te": "నేను బాధగా ఉన్నాను", "meaning": "ఐ యామ్ సాడ్"},
    {"en": "I am angry", "te": "నాకు కోపంగా ఉంది", "meaning": "ఐ యామ్ యాంగ్రీ"},
