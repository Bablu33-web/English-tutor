  "Level 6: Social & Friends": [
    {"en": "How are you doing?", "te": "మీరు ఎలా ఉన్నారు?", "meaning": "హౌ ఆర్ యూ డూయింగ్?"},
    {"en": "What is new?", "te": "కొత్త విశేషాలు ఏమిటి?", "meaning": "వాట్ ఈజ్ న్యూ?"},
    {"en": "It has been a long time", "te": "చాలా కాలమైంది", "meaning": "ఇట్ హ్యాజ్ బీన్ ఆ లాంగ్ టైమ్"},
    {"en": "I missed you", "te": "నేను నిన్ను మిస్ అయ్యాను", "meaning": "ఐ మిస్డ్ యూ"},
    {"en": "Let's meet up", "te": "మనం కలుద్దాం", "meaning": "లెట్స్ మీట్ అప్"},
    {"en": "Where should we go?", "te": "మనం ఎక్కడికి వెళ్దాం?", "meaning": "వేర్ షుడ్ వీ గో?"},
    {"en": "I like spending time with you", "te": "నీతో సమయం గడపడం నాకు ఇష్టం", "meaning": "ఐ లైక్ స్పెంటింగ్ టైమ్ విత్ యూ"},
    {"en": "You are a good friend", "te": "నువ్వు మంచి స్నేహితుడివి", "meaning": "యూ ఆర్ ఆ గుడ్ ఫ్రెండ్"},
    {"en": "Let's have coffee", "te": "మనం కాఫీ తాగుదాం", "meaning": "లెట్స్ హావ్ కాఫీ"},
    {"en": "Tell me about yourself", "te": "నీ గురించి చెప్పు", "meaning": "టెల్ మీ అబౌట్ యువర్ సెల్ఫ్"},
    {"en": "What do you like to do?", "te": "నీకు ఏమి చేయడం ఇష్టం?", "meaning": "వాట్ డూ యూ లైక్ టు డూ?"},
    {"en": "I love movies", "te": "నాకు సినిమాలు అంటే ఇష్టం", "meaning": "ఐ లవ్ మూవీస్"},
    {"en": "Do you like sports?", "te": "నీకు క్రీడలు ఇష్టమా?", "meaning": "డూ యూ లైక్ స్పోర్ట్స్?"},
    {"en": "Let's go for a walk", "te": "మనం వాకింగ్‌కు వెళ్దాం", "meaning": "లెట్స్ గో ఫర్ ఆ వాక్"},
    {"en": "What is your plan?", "te": "నీ ప్లాన్ ఏంటి?", "meaning": "వాట్ ఈజ్ యువర్ ప్లాన్?"},
    {"en": "I am free this weekend", "te": "నేను ఈ వారాంతంలో ఖాళీగా ఉన్నాను", "meaning": "ఐ యామ్ ఫ్రీ దిస్ వీకెండ్"},
    {"en": "Would you like to join me?", "te": "నీవు నాతో వస్తావా?", "meaning": "వుడ్ యూ లైక్ టు జాయిన్ మీ?"},
    {"en": "That sounds fun", "te": "అది చాలా సరదాగా ఉంది", "meaning": "దట్ సౌండ్స్ ఫన్"},
    {"en": "Sorry, I can't", "te": "క్షమించు, నేను రాలేను", "meaning": "సారీ, ఐ క్యాన్ నాట్"},
    {"en": "Maybe another time", "te": "బహుశా మరొకసారి", "meaning": "మేబీ అనదర్ టైమ్"},
    {"en": "I had a great time", "te": "నాకు చాలా బాగుంది", "meaning": "ఐ హ్యాడ్ ఆ గ్రేట్ టైమ్"},
    {"en": "Let's keep in touch", "te": "మనం టచ్‌లో ఉందాం", "meaning": "లెట్స్ కీప్ ఇన్ టచ్"},
    {"en": "You made my day", "te": "నువ్వు నా రోజును అద్భుతంగా మార్చావు", "meaning": "యూ మేడ్ మై డే"},
    {"en": "Take care of yourself", "te": "నీ జాగ్రత్త", "meaning": "టేక్ కేర్ ఆఫ్ యువర్ సెల్ఫ్"},
    {"en": "I am so proud of you", "te": "నీ గురించి నాకు చాలా గర్వంగా ఉంది", "meaning": "ఐ యామ్ సో ప్రౌడ్ ఆఫ్ యూ"},
    {"en": "You are amazing", "te": "నువ్వు అద్భుతమైన వ్యక్తివి", "meaning": "యూ ఆర్ అమేజింగ్"},
    {"en": "Thanks for listening", "te": "విన్నందుకు ధన్యవాదాలు", "meaning": "థాంక్స్ ఫర్ లిజనింగ్"},
    {"en": "I appreciate it", "te": "నేను దీన్ని అభినందిస్తున్నాను", "meaning": "ఐ అప్రిషియేట్ ఇట్"},
    {"en": "No problem", "te": "పర్వాలేదు", "meaning": "నో ప్రాబ్లం"},
    {"en": "It's my pleasure", "te": "నాకు చాలా సంతోషం", "meaning": "ఇట్స్ మై ప్లెజర్"},
    {"en": "Any plans for the holidays?", "te": "సెలవుల్లో ఏమైనా ప్లాన్స్ ఉన్నాయా?", "meaning": "ఎనీ ప్లాన్స్ ఫర్ ది హాలిడేస్?"},
    {"en": "Where did you go?", "te": "నువ్వు ఎక్కడికి వెళ్ళావు?", "meaning": "వేర్ డిడ్ యూ గో?"},
    {"en": "I went to the park", "te": "నేను పార్కుకు వెళ్ళాను", "meaning": "ఐ వెంట్ టు ది పార్క్"},
    {"en": "That sounds interesting", "te": "అది ఆసక్తికరంగా ఉంది", "meaning": "దట్ సౌండ్స్ ఇంట్రెస్టింగ్"},
    {"en": "Tell me more", "te": "ఇంకా చెప్పు", "meaning": "టెల్ మీ మోర్"},
    {"en": "Really?", "te": "నిజమా?", "meaning": "రియల్లీ?"},
    {"en": "I understand", "te": "నాకు అర్థమైంది", "meaning": "ఐ అండర్‌స్టాండ్"},
    {"en": "Let's talk later", "te": "మనం తర్వాత మాట్లాడుకుందాం", "meaning": "లెట్స్ టాక్ లేటర్"},
    {"en": "I am so happy for you", "te": "నీ గురించి నాకు చాలా సంతోషంగా ఉంది", "meaning": "ఐ యామ్ సో హ్యాపీ ఫర్ యూ"},
    {"en": "Congratulations!", "te": "అభినందనలు!", "meaning": "కంగ్రాట్యులేషన్స్!"},
    {"en": "Good luck", "te": "శుభం కలగాలి", "meaning": "గుడ్ లక్"},
    {"en": "Have a safe trip", "te": "ప్రయాణం సురక్షితంగా సాగాలి", "meaning": "హ్యావ్ ఆ సేఫ్ ట్రిప్"},
    {"en": "I hope you have fun", "te": "నీకు సరదాగా ఉండాలని కోరుకుంటున్నాను", "meaning": "ఐ హోప్ యూ హ్యావ్ ఫన్"},
    {"en": "What do you suggest?", "te": "నువ్వు ఏమి సూచిస్తావు?", "meaning": "వాట్ డూ యూ సజెస్ట్?"},
    {"en": "It depends", "te": "అది దేనిపై ఆధారపడి ఉంటుంది", "meaning": "ఇట్ డిపెండ్స్"},
    {"en": "I am not sure", "te": "నాకు ఖచ్చితంగా తెలియదు", "meaning": "ఐ యామ్ నాట్ ష్యూర్"},
    {"en": "Let me know", "te": "నాకు తెలియజేయి", "meaning": "లెట్ మీ నో"},
    {"en": "I'll call you", "te": "నేను నీకు కాల్ చేస్తాను", "meaning": "ఐ విల్ కాల్ యూ"},
    {"en": "See you soon", "te": "త్వరలో కలుద్దాం", "meaning": "సీ యూ సూన్"},
    {"en": "Bye-bye", "te": "బై-బై", "meaning": "బై-బై"}
