    {"en": "You are a good friend", "te": "యూ ఆర్ ఆ గుడ్ ఫ్రెండ్", "meaning": "నువ్వు మంచి స్నేహితుడివి"},
    {"en": "Let's have coffee", "te": "లెట్స్ హావ్ కాఫీ", "meaning": "మనం కాఫీ తాగుదాం"},
    {"en": "Tell me about yourself", "te": "టెల్ మీ అబౌట్ యువర్ సెల్ఫ్", "meaning": "నీ గురించి చెప్పు"},
    {"en": "What do you like to do?", "te": "వాట్ డూ యూ లైక్ టు డూ?", "meaning": "నీకు ఏమి చేయడం ఇష్టం?"},
    {"en": "I love movies", "te": "ఐ లవ్ మూవీస్", "meaning": "నాకు సినిమాలు అంటే ఇష్టం"},
    {"en": "Do you like sports?", "te": "డూ యూ లైక్ స్పోర్ట్స్?", "meaning": "నీకు క్రీడలు ఇష్టమా?"},
    {"en": "Let's go for a walk", "te": "లెట్స్ గో ఫర్ ఆ వాక్", "meaning": "మనం వాకింగ్‌కు వెళ్దాం"},
    {"en": "What is your plan?", "te": "వాట్ ఈజ్ యువర్ ప్లాన్?", "meaning": "నీ ప్లాన్ ఏంటి?"},
    {"en": "I am free this weekend", "te": "ఐ యామ్ ఫ్రీ దిస్ వీకెండ్", "meaning": "నేను ఈ వారాంతంలో ఖాళీగా ఉన్నాను"},
    {"en": "Would you like to join me?", "te": "వుడ్ యూ లైక్ టు జాయిన్ మీ?", "meaning": "నీవు నాతో వస్తావా?"},
