  "Level 6: Social & Friends": [
    {"en": "How are you doing?", "te": "హౌ ఆర్ యూ డూయింగ్?", "meaning": "మీరు ఎలా ఉన్నారు?"},
    {"en": "What is new?", "te": "వాట్ ఈజ్ న్యూ?", "meaning": "కొత్త విశేషాలు ఏమిటి?"},
    {"en": "It has been a long time", "te": "ఇట్ హ్యాజ్ బీన్ ఆ లాంగ్ టైమ్", "meaning": "చాలా కాలమైంది"},
    {"en": "I missed you", "te": "ఐ మిస్డ్ యూ", "meaning": "నేను నిన్ను మిస్ అయ్యాను"},
