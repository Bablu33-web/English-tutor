    {"en": "Do you accept cash?", "te": "మీరు నగదు తీసుకుంటారా?", "meaning": "డూ యూ యాక్సెప్ట్ క్యాష్?"},
    {"en": "Where is the counter?", "te": "కౌంటర్ ఎక్కడ ఉంది?", "meaning": "వేర్ ఈజ్ ది కౌంటర్?"},
    {"en": "The item is damaged", "te": "వస్తువు దెబ్బతింది", "meaning": "ది ఐటమ్ ఈజ్ డ్యామేజ్డ్"},
    {"en": "I want a refund", "te": "నాకు డబ్బులు తిరిగి ఇవ్వండి", "meaning": "ఐ వాంట్ ఆ రీఫండ్"},
    {"en": "Do you have a guarantee?", "te": "మీ దగ్గర గ్యారెంటీ ఉందా?", "meaning": "డూ యూ హావ్ ఆ గ్యారెంటీ?"},
    {"en": "This is very beautiful", "te": "ఇది చాలా అందంగా ఉంది", "meaning": "దిస్ ఈజ్ వెరీ బ్యూటిఫుల్"},
    {"en": "I will buy it later", "te": "నేను దీన్ని తర్వాత కొంటాను", "meaning": "ఐ విల్ బై ఇట్ లేటర్"},
    {"en": "It is on sale", "te": "ఇది సేల్‌లో ఉంది", "meaning": "ఇట్ ఈజ్ ఆన్ సేల్"},
    {"en": "Where is the entrance?", "te": "ప్రవేశ ద్వారం ఎక్కడ ఉంది?", "meaning": "వేర్ ఈజ్ ది ఎంట్రన్స్?"},
    {"en": "Where is the exit?", "te": "బయటకు వెళ్లే దారి ఎక్కడ ఉంది?", "meaning": "వేర్ ఈజ్ ది ఎగ్జిట్?"},
    {"en": "Is it open?", "te": "ఇది తెరిచి ఉందా?", "meaning": "ఈజ్ ఇట్ ఓపెన్?"},
    {"en": "When do you close?", "te": "మీరు ఎప్పుడు మూసివేస్తారు?", "meaning": "వెన్ డూ యూ క్లోజ్?"},
    {"en": "I am looking for a shirt", "te": "నేను చొక్కా కోసం చూస్తున్నాను", "meaning": "ఐ యామ్ లుకింగ్ ఫర్ ఆ షర్ట్"},
    {"en": "Do you have pants?", "te": "మీ దగ్గర ప్యాంటు ఉందా?", "meaning": "డూ యూ హావ్ ప్యాంట్స్?"},
    {"en": "I need shoes", "te": "నాకు బూట్లు కావాలి", "meaning": "ఐ నీడ్ షూస్"},
    {"en": "What brand is this?", "te": "ఇది ఏ బ్రాండ్?", "meaning": "వాట్ బ్రాండ్ ఈజ్ దిస్?"},
    {"en": "This fits me well", "te": "ఇది నాకు బాగా సరిపోయింది", "meaning": "దిస్ ఫిట్స్ మీ వెల్"},
    {"en": "This is too big", "te": "ఇది చాలా పెద్దది", "meaning": "దిస్ ఈజ్ టూ బిగ్"},
    {"en": "This is too small", "te": "ఇది చాలా చిన్నది", "meaning": "దిస్ ఈజ్ టూ స్మాల్"},
    {"en": "Do you have a bag?", "te": "మీ దగ్గర బ్యాగ్ ఉందా?", "meaning": "డూ యూ హావ్ ఆ బ్యాగ్?"},
    {"en": "Put it in the bag", "te": "దాన్ని బ్యాగ్‌లో పెట్టండి", "meaning": "పుట్ ఇట్ ఇన్ ది బ్యాగ్"},
    {"en": "I like the color", "te": "నాకు ఈ రంగు నచ్చింది", "meaning": "ఐ లైక్ ది కలర్"},
    {"en": "It is too bright", "te": "ఇది చాలా ప్రకాశవంతంగా ఉంది", "meaning": "ఇట్ ఈజ్ టూ బ్రైట్"},
    {"en": "Do you have something plain?", "te": "మీ దగ్గర సాధారణమైనది ఉందా?", "meaning": "డూ యూ హావ్ సంథింగ్ ప్లెయిన్?"},
    {"en": "I will think about it", "te": "నేను ఆలోచిస్తాను", "meaning": "ఐ విల్ థింక్ అబౌట్ ఇట్"},
    {"en": "Thanks for showing", "te": "చూపించినందుకు ధన్యవాదాలు", "meaning": "థాంక్స్ ఫర్ షోయింగ్"}
